# Copy to .env and fill in. .env is gitignored.

# AI Studio key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared with the room server. The judge fails closed when this is unset.
JUDGE_SHARED_SECRET=local-dev-secret

# stub returns a deterministic rule-based verdict and never calls Gemini.
# gemini is the real judge. Defaults to gemini when GEMINI_API_KEY is set.
JUDGE_MODE=stub

GEMINI_MODEL=gemini-3.1-flash-lite
JUDGE_PROMPT_VERSION=v1
JUDGE_TIMEOUT_MS=8000
