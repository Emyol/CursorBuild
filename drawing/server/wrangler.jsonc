{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doodle-fight-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "RoomServer", "class_name": "RoomServer" }]
  },
  "migrations": [
    {
      "tag": "v1",
      // sqlite-backed classes are the free-tier storage backend
      "new_sqlite_classes": ["RoomServer"]
    }
  ]
}
